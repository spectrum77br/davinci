# Redis
REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/1

# Storage local
UPLOADS_DIR=/data/uploads

# Traefik (prod)
TRAEFIK_ACME_EMAIL=spectrum77@tuta.com
DOMAIN_APP=app.hadken.com
DOMAIN_API=api.hadken.com

# Auth — Login OTP + JWT
JWT_SECRET=change-me-32-bytes-base64
JWT_TTL_SECONDS=604800
CREDENTIALS_KEY=change-me-32-bytes-base64
COOKIE_NAME=davinci_session
COOKIE_DOMAIN=
OWNER_OPEN_ID=email:spectrum77@tuta.com

# OTP
OTP_CODE_TTL_MS=600000
OTP_MAX_ATTEMPTS=5
OTP_RATE_PER_IP=3
OTP_RATE_PER_EMAIL=3
OTP_PREFIX_LEN=4
OTP_CODE_LEN=8

# Cloudflare Turnstile (optional)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Mailjet
EMAIL_FROM="DaVinci <no-reply@hadken.com>"
