# App
ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PORT=8000

# Postgres 18
POSTGRES_USER=davinci
POSTGRES_PASSWORD=change-me-davinci-pwd
POSTGRES_DB=davinci
DATABASE_URL=postgresql+asyncpg://davinci:change-me-davinci-pwd@postgres:5432/davinci
