# DaVinci .env template. Copy to .env (root). Never commit secrets.
#
# DEV (Mac): web at http://127.0.0.1:3000, api at http://127.0.0.1:8001 via SSH tunnel
# PROD (Hetzner): single domain https://app.hadken.com, path-based routing /api/*

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=development                                  # development | production
APP_URL=http://127.0.0.1:3000                    # public web URL
API_URL=http://127.0.0.1:8001                    # public api URL (build-time fallback)
API_URL_INTERNAL=                                # SSR-only; in prod set http://api:8000
PORT=8001

# ─── Postgres 18 ─────────────────────────────────────────────────────────────
POSTGRES_USER=davinci
POSTGRES_PASSWORD=change-me-davinci-pwd
POSTGRES_DB=davinci
# Dev (via SSH tunnel): host=localhost:15432
# Prod (compose network):  host=pg18:5432
DATABASE_URL=postgresql+asyncpg://davinci:change-me-davinci-pwd@localhost:15432/davinci
DATABASE_SCHEMA=davinci

# ─── Redis ───────────────────────────────────────────────────────────────────
# Dev (via SSH tunnel): host=localhost:16379
# Prod (compose network):  host=redis7:6379
REDIS_URL=redis://localhost:16379/0
ARQ_REDIS_URL=redis://localhost:16379/1

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOADS_DIR=./data/uploads                       # /data/uploads inside container

# ─── Caddy / TLS (prod only) ─────────────────────────────────────────────────
TRAEFIK_ACME_EMAIL=spectrum77@tuta.com           # email for Let's Encrypt
DOMAIN_APP=app.hadken.com

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 | tr -d '/+=' | head -c 48
JWT_SECRET=change-me-32-bytes-base64
JWT_TTL_SECONDS=604800
CREDENTIALS_KEY=change-me-32-bytes-base64
COOKIE_NAME=davinci_session
COOKIE_DOMAIN=                                   # empty = host-only
OWNER_OPEN_ID=email:spectrum77@tuta.com          # bootstraps as admin on first login

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_CODE_TTL_MS=600000                           # 10 min
OTP_MAX_ATTEMPTS=5
OTP_RATE_PER_IP=3                                # per hour
OTP_RATE_PER_EMAIL=3                             # per hour
OTP_PREFIX_LEN=4
OTP_CODE_LEN=8

# ─── Cloudflare Turnstile (optional; widget hides if SITE_KEY blank) ─────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Mailjet ─────────────────────────────────────────────────────────────────
# When MAILJET_API_KEY is blank, sender falls back to ConsoleSender (logs OTP).
EMAIL_FROM="DaVinci <no-reply@hadken.com>"
EMAIL_FROM_NAME=DaVinci
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ─── Marketplaces (fill when integrating) ────────────────────────────────────
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=https://app.hadken.com/api/oauth/bling/callback
BLING_WEBHOOK_SECRET=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_USE_SANDBOX=true
# Public callback for the Shopee OAuth login. The per-request `state` is
# appended as a trailing path segment: /api/integrations/shopee/callback/<state>
SHOPEE_REDIRECT_URI=https://app.hadken.com/api/integrations/shopee/callback

ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://app.hadken.com/api/oauth/mercadolivre/callback

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ─── Nuxt runtime overrides (web container reads NUXT_-prefixed vars) ────────
# Required in prod so the SSR'd HTML embeds the right URLs/keys; harmless in dev.
NUXT_PUBLIC_API_URL=https://app.hadken.com
NUXT_API_URL_INTERNAL=http://api:8000
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
