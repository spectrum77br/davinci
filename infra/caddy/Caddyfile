# DaVinci prod reverse proxy.
# Path-based routing on two hostnames:
#   {$DOMAIN_APP}             — full app (admin + operator)
#   gestaoestoque.com         — operator-only portal: locked to
#                               /controle-estoque by a Nuxt middleware,
#                               root redirected here by Caddy. Same
#                               backend containers.
#
# Caddy handles TLS automatically via Let's Encrypt HTTP-01.
# Email used for ACME registration is set via {$ACME_EMAIL} env var.
#
# Cloudflare proxy compatibility: HTTP-01 traverses Cloudflare's proxy
# transparently. If cert issuance fails, ensure Cloudflare's "Always
# Use HTTPS" is OFF until the first cert is issued (it would 302 the
# ACME challenge to HTTPS), or temporarily flip the DNS record to
# DNS-only ("gray cloud") for the initial issuance.

{
	email {$ACME_EMAIL}
	# auto_https on by default
}

{$DOMAIN_APP} {
	encode zstd gzip

	# ERP próprio (18/11/2026): só administrador logado no DaVinci, em modo consulta enquanto o
	# Bling manda. Vem antes de @api, porque /api/erp-local/* é do ERP. Sem o serviço erp no ar,
	# responde erro.
	@erp path /erp /erp/* /api/erp-local/*
	handle @erp {
		# Quem é e qual o papel vêm só do DaVinci: o que o navegador mandar é descartado.
		request_header -X-ERP-Actor
		request_header -X-ERP-Role
		forward_auth api:8000 {
			uri /api/erp-gate/authorize
			copy_headers X-ERP-Actor X-ERP-Role
		}
		reverse_proxy erp:8765
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		# O conector do Claude leva o token no path: mascara antes de logar.
		format filter {
			wrap console
			fields {
				request>uri regexp "claude-mcp/[0-9a-f]+" "claude-mcp/***"
			}
		}
	}
}

# ── Outros projetos que dividem este proxy de borda ──────────────────────
# Blocos de sites de OUTROS projetos (ex.: 67why/invoicer) moram no host em
# /opt/edge/caddy-sites (montado read-only em /etc/caddy/sites-enabled), FORA
# deste repo — `git reset`/clone do DaVinci nunca os toca. Cada projeto larga
# seu próprio <nome>.caddy lá. Glob sem match = no-op.
import /etc/caddy/sites-enabled/*.caddy

gestaoestoque.com, www.gestaoestoque.com {
	encode zstd gzip

	# Root → operator's only page. Saves a round-trip vs letting the
	# Nuxt middleware redirect on the client.
	@root path /
	redir @root /controle-estoque

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
