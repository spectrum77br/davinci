<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Denúncia (30/09/2026): manda a cópia de Anúncios/Denúncias/Casos do sistema de
  Fiscalização para o DaVinci a cada 5 min. Instalar em
  ~/Library/LaunchAgents/ do usuário makisatradingltda (ver LEIAME.md).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davinci.denuncia-envio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/makisatradingltda/DaVinci/denuncia/enviar_ao_davinci.py</string>
    <!-- 30/09: os arquivos das provas ficam no MEGA; só os dados vêm pro DaVinci -->
    <string>--so-dados</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/makisatradingltda/Library/Logs/davinci_denuncia.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/makisatradingltda/Library/Logs/davinci_denuncia.launchd.log</string>
</dict>
</plist>
