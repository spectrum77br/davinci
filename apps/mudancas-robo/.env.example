# Robô de mudanças do DaVinci — copiar para ~/DaVinci/mudancas-robo/.env (o instalar.sh faz)
# e preencher. NUNCA comitar o .env de verdade.

# O DaVinci e o token PRÓPRIO do robô (o mesmo valor de MUDANCAS_AGENT_TOKEN no .env do servidor).
DAVINCI_API_URL=https://app.hadken.com
MUDANCAS_AGENT_TOKEN=

# Nome deste robô (aparece na trilha do pedido).
ROBO_NOME=mac-eduardo

# Onde está o repositório (o robô cria uma worktree por pedido em PASTA_MUDANCAS).
REPO=~/davinci
PASTA_MUDANCAS=~/davinci-mudancas

# Publicação: ssh para o servidor (roda o davinci-deploy, com a trava e as recusas dele).
DEPLOY_SSH=root@46.225.188.20
DEPLOY_SSH_CHAVE=~/.ssh/coolify
# mínimo de disco livre no servidor para publicar, DEPOIS de apagar o que não interfere
# (cache de build sem uso, imagens sem nome); 17/11: publicado com 6,2 GB sem problema
DISCO_MIN_GB=6
FAXINA_DIAS=7

# Testes: Postgres DESCARTÁVEL criado dentro da caixa (binários daqui) e os
# node_modules da tela (só leitura) para compilar e testar a tela.
PG_BIN=/opt/homebrew/opt/postgresql@18/bin
NODE_PATH_WEB=~/davinci/apps/web/node_modules

# O Claude do robô.
MODELO=claude-opus-5-5
ESFORCO=high
LIMITE_MINUTOS=40
# CLAUDE_BIN=   (opcional; sem isto usa ~/.local/bin/claude ou o que vem dentro do app Claude)
# O token do Claude fica em .env.claude (guardar_token.sh), não aqui.
