# ─── DaVinci Executor (braço local) — configuração ────────────────────────
# Copie para `.env` e preencha. NUNCA versione o .env (o .gitignore já bloqueia).

# ── Ligação com o control plane do DaVinci ────────────────────────────────
# Base da API do DaVinci (SEM barra no fim). Ex.: produção https://SEU-DOMINIO
# ou, testando local, http://localhost:8000
DAVINCI_API_URL=http://localhost:8000
# Token compartilhado M2M. TEM que ser IGUAL ao MARKETING_AGENT_TOKEN do DaVinci
# (settings.marketing_agent_token). Vazio → o DaVinci recusa tudo com 401.
MARKETING_AGENT_TOKEN=
# Nome do agente que aparece no dashboard (badge "Executor local"). Mantido
# como "marionete" por continuidade; pode trocar.
AGENT_NAME=marionete

# ── Ritmo do loop ─────────────────────────────────────────────────────────
LEASE_LIMIT=10              # quantos comandos puxar por vez em /agent/lease
POLL_INTERVAL_MS=15000      # de quanto em quanto tempo puxa trabalho (15s)
HEARTBEAT_INTERVAL_MS=60000 # de quanto em quanto manda sinal de vida (60s; o
                            # DaVinci considera ONLINE se < 120s)
PROFILE_GAP_MS=2000         # intervalo entre abrir um perfil e o próximo
                            # (a Local API do AdsPower tem rate-limit ~1 req/s)

# ── Modo padrão de liga/desliga (quando o comando não especifica) ─────────
# 'manual' = por anúncio (o que você mais usa) | 'gmvmax' = a loja inteira
EXECUTOR_DEFAULT_MODE=manual
EXECUTOR_DEFAULT_SCOPE=all  # p/ modo manual: all | ids | names

# ── AdsPower (Local API no próprio Mac) ───────────────────────────────────
ADSPOWER_API_BASE=http://local.adspower.net:50325
ADSPOWER_API_KEY=           # normalmente não exigido pela Local API

# ── Shopee ────────────────────────────────────────────────────────────────
SHOPEE_SELLER_ADS_URL=https://seller.shopee.com.br/portal/marketing/pas/index
DEBUG_DIR=./debug           # screenshots/HTML de diagnóstico

# ── TRAVA DE SEGURANÇA ────────────────────────────────────────────────────
# Enquanto for diferente de "true", applyState() LANÇA erro de propósito: o
# executor conecta e loga, mas NÃO altera nenhum anúncio (os comandos voltam
# como "failed"). Vire para true só quando quiser deixar o Mac agir sozinho.
SELECTORS_CALIBRATED=false

# ── Telegram (opcional — alertas de needs_manual_login / falhas) ──────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
