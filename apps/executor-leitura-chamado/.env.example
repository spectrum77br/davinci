# ─── Executor de leitura de chamado — configuração ─────────────────────────
# Copie para `.env` e preencha. NUNCA versione o .env (o .gitignore já bloqueia).

# ── DaVinci ────────────────────────────────────────────────────────────────
DAVINCI_API_URL=https://app.hadken.com
# Senha PRÓPRIA deste robô (tabela chamados_leitores; o DaVinci guarda só o
# sha256). Não é o token do Marketing nem o do robô de NF.
LEITOR_TOKEN=

# ── Modo ───────────────────────────────────────────────────────────────────
#   seco = lê e grava em logs/seco/, NÃO manda nada pro chamado (default)
#   real = manda o que leu pro chamado
LEITURA_MODO=seco
LEITURA_INTERVALO_MS=600000   # pergunta a fila a cada 10 min (a cadência de cada caso é do DaVinci)
LEITURA_LIMITE=10             # casos por passada
PROFILE_GAP_MS=3000           # pausa entre uma loja e outra

# ── AdsPower (Local API no próprio Mac) ────────────────────────────────────
ADSPOWER_API_BASE=http://local.adspower.net:50325
ADSPOWER_API_KEY=
# Reabre o AdsPower se ele fechar (Mac Santiago: "AdsPower Global").
ADSPOWER_APP=AdsPower Global

# Loja do chamado -> perfil, pras que o nome do perfil não casa sozinho
# (o casamento automático é "<Loja> - Shopee" -> "Shopee <Loja>").
# Ex.: PERFIS_EXTRA={"Shopee Jlas":"k1dkfg0k"}
PERFIS_EXTRA=

SHOPEE_SELLER_URL=https://seller.shopee.com.br
DEBUG_DIR=./debug
SECO_DIR=./logs/seco
