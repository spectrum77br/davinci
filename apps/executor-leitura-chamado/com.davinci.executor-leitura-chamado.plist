<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent do Executor de leitura de chamado (Mac Santiago).
  TEM que ser LaunchAgent (sessão gráfica do usuário) para enxergar o AdsPower.

    cp com.davinci.executor-leitura-chamado.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.davinci.executor-leitura-chamado.plist
  Logs em ~/DaVinci/executor-leitura-chamado/logs/
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davinci.executor-leitura-chamado</string>

    <!-- caffeinate -i: o Mac não dorme por inatividade enquanto o robô roda. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/santiagogeral/DaVinci/executor-leitura-chamado/node_modules/.bin/tsx</string>
        <string>/Users/santiagogeral/DaVinci/executor-leitura-chamado/src/index.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/santiagogeral/DaVinci/executor-leitura-chamado</string>

    <key>UserName</key>
    <string>santiagogeral</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/santiagogeral/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/santiagogeral/DaVinci/executor-leitura-chamado/logs/executor.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/santiagogeral/DaVinci/executor-leitura-chamado/logs/executor.err.log</string>
</dict>
</plist>
