# Nonsecret API settings. Install on the host as /etc/davinci/celulares/runtime.env.
# Empty URL/allowlist disables the feature. Enable only after the private tunnel
# and authenticated gateway are installed and verified separately.
CELULARES_API_URL=
CELULARES_API_SOCKET=
CELULARES_ALLOWLIST=
CELULARES_CAMERA_PILOT_ENABLED=false
CELULARES_STREAM_ORIGIN=
